# Fonts
font.family        : serif
font.serif         : Times New Roman, Times, DejaVu Serif
mathtext.fontset   : stix
mathtext.default   : it
font.size          : 14

# Grid
axes.grid          : True
axes.axisbelow     : True

grid.color         : 0.75
grid.linestyle     : :
grid.linewidth     : 0.6
grid.alpha         : 0.35


# Lines
lines.linestyle        : -
lines.linewidth        : 1.8
lines.markersize       : 5.0
lines.markeredgewidth  : 1.0


# Axis
axes.labelsize       : 16
axes.titlesize       : 16
axes.linewidth       : 1.0
axes.labelpad        : 7
axes.titlepad        : 8
axes.facecolor       : white
axes.edgecolor       : black

axes.formatter.use_mathtext : True
axes.formatter.limits       : -3, 3

# Color cycle for plot lines as list of string color specs.
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', '000000'])


# Ticks

## x ticks
xtick.labelsize      : 13
xtick.direction      : in
xtick.top            : True
xtick.major.size     : 5
xtick.minor.size     : 3
xtick.major.width    : 1.0
xtick.minor.width    : 0.8
xtick.major.pad      : 5

## y ticks
ytick.labelsize      : 13
ytick.direction      : in
ytick.right          : True
ytick.major.size     : 5
ytick.minor.size     : 3
ytick.major.width    : 1.0
ytick.minor.width    : 0.8
ytick.major.pad      : 5


# Legend
legend.fancybox       : False
legend.frameon        : True
legend.fontsize       : 12
legend.title_fontsize : 13
legend.labelspacing   : 0.30
legend.handlelength   : 1.8
legend.handletextpad  : 0.5
legend.borderaxespad  : 0.4


# Figure
figure.figsize       : 7.0, 5.0
figure.dpi           : 150
figure.facecolor     : white
figure.edgecolor     : white
figure.titlesize     : 18
figure.titleweight   : 600


# Images / colormaps
image.cmap           : viridis
image.interpolation  : nearest


# Error bars
errorbar.capsize     : 2.5


# 3D axes
axes3d.grid          : True


# Saving
savefig.format       : png
savefig.dpi          : 600
savefig.facecolor    : white
savefig.edgecolor    : white
savefig.bbox         : tight
savefig.pad_inches   : 0.04

# Keep text editable/searchable in vector files.
pdf.fonttype         : 42
ps.fonttype          : 42
svg.fonttype         : none
